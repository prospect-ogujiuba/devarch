{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devarch.test/schemas/maker-stack.schema.json",
  "title": "DevArch Maker stack release manifest",
  "type": "object",
  "required": ["schemaVersion", "channels", "stacks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "channels": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
    },
    "stacks": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["releasedAt", "packages"],
        "additionalProperties": false,
        "properties": {
          "releasedAt": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" },
          "packages": {
            "type": "object",
            "required": ["makerstarter", "makerblocks", "makermaker"],
            "additionalProperties": false,
            "properties": {
              "makerstarter": { "$ref": "#/$defs/package" },
              "makerblocks": { "$ref": "#/$defs/package" },
              "makermaker": { "$ref": "#/$defs/package" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "required": ["type", "repository", "ref", "commit", "healthFile", "install"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["theme", "plugin"] },
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "pattern": "^(v[0-9]+\\.[0-9]+\\.[0-9]+|main)$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "healthFile": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        "install": { "enum": ["none", "composer-no-dev"] }
      }
    }
  }
}
