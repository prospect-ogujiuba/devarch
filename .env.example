# DevArch host bootstrap configuration
# Copy to .env only when you need overrides. Replace blank required secrets before
# a mutating run. These values are read by the WordPress/Laravel host scripts;
# they do not configure every Compose service.

# Shared MariaDB credential. Keep the password used to initialize an existing
# MariaDB volume; changing this value does not rotate that volume's password.
MARIADB_ROOT_PASSWORD=

# WordPress bootstrap (WP_ADMIN_* is preferred; legacy ADMIN_* aliases remain accepted).
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@devarch.test
GITHUB_USER=github-user
AIOWM_GIT_URL=
WORDPRESS_CONTAINER_USER=

# Laravel bootstrap. Blank values use the documented derived/default behavior.
LARAVEL_APP_NAME=
LARAVEL_APP_URL=
LARAVEL_DB_ROOT_PASSWORD=
LARAVEL_CONTAINER_USER=

# Optional host runtime override: podman or docker.
CONTAINER_RUNTIME=
