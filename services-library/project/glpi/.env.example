# Copy to .env, generate unique values, and chmod 600 .env.
GLPI_DB_PASSWORD=replace-with-a-long-random-value
GLPI_DB_ROOT_PASSWORD=replace-with-a-different-long-random-value
# GLPI initially creates glpi/glpi; change it immediately after first startup.
GLPI_ADMIN_PASSWORD=replace-with-a-long-random-value
