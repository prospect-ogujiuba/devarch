# Copy to .env, generate unique values, and chmod 600 .env.
# Use URL-safe characters for OPENPROJECT_DB_PASSWORD because it is embedded in DATABASE_URL.
OPENPROJECT_DB_PASSWORD=replace-with-a-long-random-url-safe-value
OPENPROJECT_SECRET_KEY_BASE=replace-with-at-least-64-random-hex-characters
OPENPROJECT_ADMIN_LOGIN=admin
OPENPROJECT_ADMIN_PASSWORD=replace-with-a-long-random-value
OPENPROJECT_ADMIN_EMAIL=admin@devarch.test
